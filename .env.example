# Copy to .env.local and fill in. All keys are free-tier.
# The app also runs with these blank (demo mode: offline parser, no auth).

# Gemini — https://aistudio.google.com/apikey  (server-side only)
GEMINI_API_KEY=

# Supabase — Dashboard ▸ Project Settings ▸ API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL — used for auth redirects (set the deployed URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
